{
  "appId": "com.openvolley.readvolley",
  "appName": "ReadVolley",
  "webDir": "dist-capacitor",
  "backgroundColor": "#f5f5f4",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SystemBars": {
      "style": "LIGHT",
      "insetsHandling": "disable"
    },
    "SplashScreen": {
      "launchShowDuration": 800,
      "launchAutoHide": true,
      "backgroundColor": "#131D1F",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_INSIDE",
      "showSpinner": false
    }
  }
}
